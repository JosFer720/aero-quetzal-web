{
  "name": "@aeroquetzal/internal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test e2e",
    "test": "vitest run",
    "test:e2e": "npm run build --workspace @aeroquetzal/domain && npm run build --workspace @aeroquetzal/api-contracts && npm run build --workspace @aeroquetzal/auth-service && playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort"
  },
  "dependencies": {
    "@aeroquetzal/api-contracts": "0.1.0",
    "@aeroquetzal/domain": "0.1.0",
    "@aeroquetzal/ui": "0.1.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aeroquetzal/auth-service": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fastify": "^5.12.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  }
}
